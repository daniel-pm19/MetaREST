{
    "openapi": "3.1.0",
    "info": {
        "title": "MetaREST demo SUT",
        "description": "Stable catalog. Filters use AND; total is measured before pagination; ordering is deterministic.",
        "version": "0.1.0"
    },
    "paths": {
        "/health": {
            "get": {
                "summary": "Health",
                "operationId": "health_health_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "additionalProperties": {
                                        "type": "string"
                                    },
                                    "type": "object",
                                    "title": "Response Health Health Get"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/search": {
            "get": {
                "summary": "Search",
                "operationId": "search_search_get",
                "parameters": [
                    {
                        "name": "q",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "description": "Case-insensitive substring of the item name",
                            "default": "",
                            "title": "Q"
                        },
                        "description": "Case-insensitive substring of the item name",
                        "examples": {
                            "jazz": {
                                "value": "jazz"
                            }
                        }
                    },
                    {
                        "name": "category",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "$ref": "#/components/schemas/Category"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Exact category filter combined with q using AND",
                            "title": "Category"
                        },
                        "description": "Exact category filter combined with q using AND",
                        "examples": {
                            "vinyl": {
                                "value": "vinyl"
                            }
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 100,
                            "minimum": 1,
                            "description": "Maximum number of results per page",
                            "default": 20,
                            "title": "Limit"
                        },
                        "description": "Maximum number of results per page",
                        "examples": {
                            "small": {
                                "value": 10
                            }
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "Page number, starting at 1",
                            "default": 1,
                            "title": "Page"
                        },
                        "description": "Page number, starting at 1",
                        "examples": {
                            "first": {
                                "value": 1
                            }
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "$ref": "#/components/schemas/Sort",
                            "description": "Sort mode; changing sort preserves all matches before pagination",
                            "default": "id_asc"
                        },
                        "description": "Sort mode; changing sort preserves all matches before pagination",
                        "examples": {
                            "stable": {
                                "value": "id_asc"
                            }
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SearchResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/items/{item_id}": {
            "get": {
                "summary": "Item",
                "operationId": "item_items__item_id__get",
                "parameters": [
                    {
                        "name": "item_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "title": "Item Id"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Item"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Category": {
                "type": "string",
                "enum": [
                    "vinyl",
                    "cd"
                ],
                "title": "Category"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "Item": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Id",
                        "description": "Stable unique catalog identifier",
                        "examples": [
                            1
                        ]
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "examples": [
                            "jazz collection 01"
                        ]
                    },
                    "category": {
                        "$ref": "#/components/schemas/Category"
                    },
                    "price": {
                        "type": "number",
                        "title": "Price"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "category",
                    "price"
                ],
                "title": "Item"
            },
            "SearchResponse": {
                "properties": {
                    "total": {
                        "type": "integer",
                        "title": "Total",
                        "description": "Number of matching items before pagination",
                        "examples": [
                            24
                        ]
                    },
                    "results": {
                        "items": {
                            "$ref": "#/components/schemas/Item"
                        },
                        "type": "array",
                        "title": "Results",
                        "description": "The requested page in deterministic order"
                    }
                },
                "type": "object",
                "required": [
                    "total",
                    "results"
                ],
                "title": "SearchResponse"
            },
            "Sort": {
                "type": "string",
                "enum": [
                    "id_asc",
                    "price_asc",
                    "price_desc"
                ],
                "title": "Sort"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "ctx": {
                        "type": "object",
                        "title": "Context"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}
