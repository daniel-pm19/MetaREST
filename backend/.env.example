# Copy to backend/.env (git-ignored) and fill in. Never commit real values.

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=metarest
# Required: generate with python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional for local startup; both required by the all-in-one Compose example.
# Seed is idempotent and never resets an existing account's password/role.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
FASTEMBED_CACHE_DIR=../.fastembed_cache
# Optional per-project authentication. Set the project's auth_env_key to the
# exact variable name. Projects without auth_env_key always send empty auth headers.
# SUT_CATALOG_HEADERS={"Authorization":"Bearer REPLACE_LOCALLY"}
FAULTS=

# LLM (Claude Console API key; a Claude Pro subscription does not include API access)
ANTHROPIC_API_KEY=

# Gemini: initial platform provider. Availability/quotas depend on the account/model.
GEMINI_API_KEY=
